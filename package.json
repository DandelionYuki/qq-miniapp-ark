{
  "name": "qq-miniapp-ark",
  "version": "0.2.1",
  "description": "让 QQ 机器人的小程序卡片点开直达某一页：从本机 QQ 缓存里挖出小程序的页面路径（OneBot 11 / NapCat）",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./bilibili": "./src/bilibili.mjs",
    "./discover": "./src/discover.mjs"
  },
  "files": [
    "src",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "example:bili": "node examples/bilibili.mjs",
    "example:discover": "node examples/discover.mjs"
  },
  "keywords": [
    "qq",
    "miniapp",
    "miniprogram",
    "ark",
    "card",
    "onebot",
    "napcat",
    "jumpUrl",
    "bilibili"
  ],
  "author": "DandelionYuki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DandelionYuki/qq-miniapp-ark.git"
  },
  "homepage": "https://github.com/DandelionYuki/qq-miniapp-ark#readme",
  "bugs": {
    "url": "https://github.com/DandelionYuki/qq-miniapp-ark/issues"
  },
  "license": "MIT",
  "dependencies": {}
}
